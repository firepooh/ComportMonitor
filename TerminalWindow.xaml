<Window x:Class="ComportMonitor.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terminal Command"
        Icon="ComportMonitor.ico"
        Background="#FF171B24"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Width="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="TERMINAL COMMAND" Foreground="#93A3B8" FontSize="11" FontWeight="Bold"/>
        <TextBlock Foreground="#6B7280" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap"
                   Text="Run by 'Open in terminal' in the port menu. Leave it empty to detect PuTTY or Tera Term automatically."/>

        <TextBox x:Name="CommandBox" FontFamily="Consolas" TextChanged="CommandBox_TextChanged"/>

        <TextBlock Margin="0,8,0,0" Foreground="#93A3B8" FontSize="11">
            <Run Text="{}{port}" FontFamily="Consolas" Foreground="#7DD3FC"/>
            <Run Text=" → COM4      "/>
            <Run Text="{}{num}" FontFamily="Consolas" Foreground="#7DD3FC"/>
            <Run Text=" → 4"/>
        </TextBlock>

        <TextBlock Margin="0,10,0,0" Foreground="#6B7280" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap">
            <Run Text="PuTTY     &quot;...\putty.exe&quot; -serial {port} -sercfg 115200,8,n,1,N"/>
            <LineBreak/>
            <Run Text="Tera Term &quot;...\ttermpro.exe&quot; /C={num} /BAUD=115200"/>
        </TextBlock>

        <DockPanel Margin="0,14,0,0">
            <Button DockPanel.Dock="Left" Content="Detect" Click="Detect_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Content="Save" IsDefault="True" Click="Save_Click" Background="#FF1E4D6B"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="#6B7280" FontSize="11"
                       Margin="12,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </StackPanel>
</Window>
